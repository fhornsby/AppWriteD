{% set typeName = definitionName | dTypeName %}
{% set extraName = definition.properties.data is defined ? 'extraData' : 'data' %}
module appwrite.models.{{ definitionName | dModule }};

import std.json : JSONType, JSONValue;
import std.typecons : Nullable;

import appwrite.json;
import enums = appwrite.enums;
import models = appwrite.models;

{{ (definition.description ?: (definitionName | caseUcfirst)) | dDoc }}struct {{ typeName }}
{
{% for property in definition.properties %}
{% set required = property | schemaRequired %}
{% set default = property | dFieldDefault(required, spec) %}
{{ property.description | dDoc(4) }}    @jsonKey({{ (property | schemaName) | dString }}) {{ property | dFieldType(required, spec) }} {{ (property | schemaName) | dFieldName }}{% if default %} = {{ default | raw }}{% endif %};
{% if not loop.last or definition.additionalProperties %}

{% endif %}
{% endfor %}
{% if definition.additionalProperties %}
    /// The whole JSON object, including attributes not declared above (such as your own columns).
    @jsonExtra JSONValue {{ extraName }};
{% endif %}

    /// Parse a `{{ typeName }}` from JSON.
    static {{ typeName }} fromJson(JSONValue json)
    {
        return deserialize!({{ typeName }})(json);
    }

    /// Convert to JSON.
    JSONValue toJson()
    {
        return serialize(this);
    }

    /// JSON text of this model.
    string toString()
    {
        return toJSONString(toJson());
    }
{% if definition.additionalProperties %}

    /// The attribute `key` from the full JSON object, or a null JSONValue when absent.
    JSONValue opIndex(string key)
    {
        if ({{ extraName }}.type != JSONType.object)
            return JSONValue.init;
        if (auto value = key in {{ extraName }})
            return *value;
        return JSONValue.init;
    }

    /// Convert the full JSON object to your own type, e.g. a struct describing your columns.
    T convertTo(T)()
    {
        return deserialize!T({{ extraName }});
    }
{% endif %}
}
